\edef\csee@fontset{\cseefontset}

% Windows 方案需要完整的六种基准字体；否则继续探测可移植方案。
\newcommand{\csee@select@auto@portable}{%
  \IfFontExistsTF{Songti SC}{%
    \IfFontExistsTF{Heiti SC}{%
      \IfFontExistsTF{STFangsong}{%
        \IfFontExistsTF{Kaiti SC}{%
          \IfFontExistsTF{Times New Roman}{%
            \IfFontExistsTF{Arial}{\def\csee@fontset{mac}}{\csee@select@auto@noto}%
          }{\csee@select@auto@noto}%
        }{\csee@select@auto@noto}%
      }{\csee@select@auto@noto}%
    }{\csee@select@auto@noto}%
  }{\csee@select@auto@noto}%
}
\newcommand{\csee@select@auto@noto}{%
  \IfFontExistsTF{Noto Serif CJK SC}{%
    \IfFontExistsTF{Noto Sans CJK SC}{\def\csee@fontset{noto}}{\def\csee@fontset{fandol}}%
  }{\def\csee@fontset{fandol}}%
}
\newcommand{\csee@select@auto}{%
  \IfFontExistsTF{SimSun}{%
    \IfFontExistsTF{SimHei}{%
      \IfFontExistsTF{FangSong}{%
        \IfFontExistsTF{KaiTi}{%
          \IfFontExistsTF{Times New Roman}{%
            \IfFontExistsTF{Arial}{\def\csee@fontset{windows}}{\csee@select@auto@portable}%
          }{\csee@select@auto@portable}%
        }{\csee@select@auto@portable}%
      }{\csee@select@auto@portable}%
    }{\csee@select@auto@portable}%
  }{\csee@select@auto@portable}%
}
\ifdefstring{\csee@fontset}{auto}{\csee@select@auto}{}

% 兼容 v0.2/v0.3 的 Windows GB2312 配置。该开关只影响 windows 方案。
\providecommand{\cseefontprofile}{fallback}
\@ifundefined{csee@fontprofile}{}{\let\cseefontprofile\csee@fontprofile}

\newcommand{\csee@set@latin@office}{%
  \setmainfont{Times New Roman}%
  \setsansfont{Arial}%
  \setmonofont{Times New Roman}%
  \newfontfamily\cseetnr{Times New Roman}%
}
\newcommand{\csee@set@latin@texgyre@base}{%
  \setmainfont{texgyretermes}[
    Extension=.otf,UprightFont=*-regular,BoldFont=*-bold,
    ItalicFont=*-italic,BoldItalicFont=*-bolditalic]%
  \setsansfont{texgyreheros}[
    Extension=.otf,UprightFont=*-regular,BoldFont=*-bold,
    ItalicFont=*-italic,BoldItalicFont=*-bolditalic]%
  \newfontfamily\cseetnr{texgyretermes}[
    Extension=.otf,UprightFont=*-regular,BoldFont=*-bold,
    ItalicFont=*-italic,BoldItalicFont=*-bolditalic]%
}
\newcommand{\csee@set@latin@texgyre}{%
  \csee@set@latin@texgyre@base
  \setmonofont{texgyrecursor}[
    Extension=.otf,UprightFont=*-regular,BoldFont=*-bold,
    ItalicFont=*-italic,BoldItalicFont=*-bolditalic,
    Scale=MatchLowercase,Ligatures=CommonOff]%
}
\newcommand{\csee@set@cjk@windows}{%
  \setCJKmainfont{SimSun}%
  \setCJKsansfont{SimHei}%
  \setCJKmonofont{SimSun}%
  \newCJKfontfamily\songti{SimSun}%
  \newCJKfontfamily\cseesongbold{SimSun}[FakeBold=2]%
  \newCJKfontfamily\heiti{SimHei}%
  \ifdefstring{\cseefontprofile}{gb2312}{%
    \newCJKfontfamily\fangsong{FangSong_GB2312}%
    \newCJKfontfamily\kaishu{KaiTi_GB2312}%
    \newfontfamily\cseekailatin{KaiTi_GB2312}%
  }{%
    \newCJKfontfamily\fangsong{FangSong}%
    \newCJKfontfamily\kaishu{KaiTi}%
    \newfontfamily\cseekailatin{KaiTi}%
  }%
}
\newcommand{\csee@set@cjk@mac}{%
  \defaultCJKfontfeatures{}%
  \setCJKmainfont{Songti SC}[UprightFont=* Light,BoldFont=* Bold]%
  \setCJKsansfont{Heiti SC}[UprightFont=* Medium]%
  \setCJKmonofont{STFangsong}%
  \newCJKfontfamily\songti{Songti SC}[UprightFont=* Light,BoldFont=* Bold]%
  \newCJKfontfamily\cseesongbold{Songti SC}[UprightFont=* Bold]%
  \newCJKfontfamily\heiti{Heiti SC}[UprightFont=* Medium]%
  \newCJKfontfamily\fangsong{STFangsong}%
  \newCJKfontfamily\kaishu{Kaiti SC}[UprightFont=* Regular,BoldFont=* Bold]%
  \newfontfamily\cseekailatin{Kaiti SC}[UprightFont=* Regular,BoldFont=* Bold]%
}
\newcommand{\csee@set@cjk@noto}{%
  \defaultCJKfontfeatures{}%
  \setCJKmainfont{Noto Serif CJK SC}[Script=CJK,BoldFont=* Bold]%
  \setCJKsansfont{Noto Sans CJK SC}[Script=CJK]%
  \setCJKmonofont{FandolFang}[Extension=.otf,UprightFont=*-Regular]%
  \newCJKfontfamily\songti{Noto Serif CJK SC}[Script=CJK,BoldFont=* Bold]%
  \newCJKfontfamily\cseesongbold{Noto Serif CJK SC}[
    Script=CJK,UprightFont=* Bold]%
  \newCJKfontfamily\heiti{Noto Sans CJK SC}[Script=CJK]%
  \newCJKfontfamily\fangsong{FandolFang}[Extension=.otf,UprightFont=*-Regular]%
  \newCJKfontfamily\kaishu{FandolKai}[Extension=.otf,UprightFont=*-Regular]%
  \newfontfamily\cseekailatin{FandolKai-Regular.otf}%
}
\newcommand{\csee@set@cjk@fandol}{%
  \defaultCJKfontfeatures{}%
  \setCJKmainfont{FandolSong}[
    Extension=.otf,UprightFont=*-Regular,BoldFont=*-Bold]%
  \setCJKsansfont{FandolHei}[
    Extension=.otf,UprightFont=*-Regular,BoldFont=*-Bold]%
  \setCJKmonofont{FandolFang}[Extension=.otf,UprightFont=*-Regular]%
  \newCJKfontfamily\songti{FandolSong}[
    Extension=.otf,UprightFont=*-Regular,BoldFont=*-Bold]%
  \newCJKfontfamily\cseesongbold{FandolSong}[
    Extension=.otf,UprightFont=*-Bold]%
  \newCJKfontfamily\heiti{FandolHei}[
    Extension=.otf,UprightFont=*-Regular,BoldFont=*-Bold]%
  \newCJKfontfamily\fangsong{FandolFang}[Extension=.otf,UprightFont=*-Regular]%
  \newCJKfontfamily\kaishu{FandolKai}[Extension=.otf,UprightFont=*-Regular]%
  \newfontfamily\cseekailatin{FandolKai-Regular.otf}%
}

\ifdefstring{\csee@fontset}{windows}{%
  \csee@set@latin@office\csee@set@cjk@windows
}{\ifdefstring{\csee@fontset}{mac}{%
  \csee@set@latin@office\csee@set@cjk@mac
}{\ifdefstring{\csee@fontset}{noto}{%
  \csee@set@latin@texgyre\csee@set@cjk@noto
}{\ifdefstring{\csee@fontset}{fandol}{%
  \csee@set@latin@texgyre\csee@set@cjk@fandol
}{\ifdefstring{\csee@fontset}{overleaf}{%
  \csee@set@latin@texgyre@base\csee@set@cjk@fandol
}{%
  \PackageError{csee}{Unknown fontset `\csee@fontset'}%
    {Use auto, windows, mac, noto, fandol, or overleaf. Falling back to fandol.}%
  \def\csee@fontset{fandol}%
  \csee@set@latin@texgyre\csee@set@cjk@fandol
}}}}}
\edef\cseeactualfontset{\csee@fontset}
\PackageInfo{csee}{Requested fontset `\cseefontset'; selected `\cseeactualfontset'}

