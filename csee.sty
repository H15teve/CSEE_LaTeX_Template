%% 14. 金样参考文献环境 \cseebibliography (golden-demo 用)             %%
%%     独立标题段落(不套 \section*),list 参数显式设置各项缩进与间距     %%
%%     9pt/14pt,悬挂缩进0.63cm                                         %%
%%------------------------------------------------------------------%%
\newenvironment{cseebibliography}{%
  \par\vspace{4pt}%
  % 独立标题段落:10.5pt 黑体左齐,与 Word 金样一致,不调用 \section*
  {\wuhao\heiti\noindent 参考文献\par}\vspace{4pt}%
  \fontsize{9pt}{14pt}\selectfont
  % Word 格式说明段(独立段落,不产生编号)
  \noindent\hspace*{2em}参考文献为小五宋，英文字体为Times New Roman，编号后空2小格。行距14pt，悬挂缩进0.63cm，悬挂缩进与首行对齐。标点除括弧为半角外，其余均为全角。\par
  \noindent\hspace*{2em}根据国家标准GB/T 7714—2005《文后参考文献著录规则》，我刊的参考文献著录格式如下：\par
  % Word 金样允许首条文献从第2页右栏底部起排，并在第3页左栏续排。
  % 不对首条使用 Needspace，否则附录及作者简介会整体下移约22mm。
  \vspace*{14pt}% 首条从下一条14pt文档网格线开始
  \begin{list}{[\arabic{csee@bibcntr}]}{%
    \usecounter{csee@bibcntr}%
    \setlength{\leftmargin}{0.63cm}%    悬挂缩进0.63cm
    \setlength{\itemindent}{0pt}%
    \setlength{\labelwidth}{0.55cm}%    [N] 标签宽
    \setlength{\labelsep}{0.08cm}%
    \setlength{\itemsep}{0pt}%          条目间距0(Word 参考文献行距14pt紧凑)
    \setlength{\parsep}{0pt}%
    \setlength{\topsep}{0pt}%
  }%
}{\end{list}}
\newcounter{csee@bibcntr}

%%------------------------------------------------------------------%%
%% 15. 作者简介 (拆分:说明文字+照片条目)                                %%
%%     \cseebiographyintro{说明文字} — 允许跨栏跨页                    %%
%%     \cseeauthorbio{照片}{个人条目} — 照片+条目绑定,\Needspace保证    %%
%%------------------------------------------------------------------%%
\RequirePackage{needspace}
% Word 原模板在附录与作者简介之间使用 4cm、0.75bp 的短分割线。
% 纵向间距按 Word 的英文图 A3 图题底边到分割线约 11.07pt 校准；
% 水平轻微负移用于补偿 Word 分栏左边界与 TeX 栏起点的 0.293bp 差异。
\newcommand{\cseebiographydivider}{%
  \par\vspace{-3.584pt}\noindent\hspace*{-0.293bp}\rule{4cm}{0.75bp}\par\vspace{3pt}}
% 正式稿作者简介标签：在照片右侧绕排块中使用小五黑体。
\newcommand{\cseebiographylabel}{{\heiti 作者简介：}}
% 作者简介说明文字(允许跨栏跨页)
\newcommand{\cseebiographyintro}[1]{\cseebiographydivider{\xiaowu\songti\cseetnr\setlength{\parindent}{0.63cm}#1\par}}
% 带照片的作者条目(照片与条目绑定,\Needspace确保照片和若干行一起移动)
\newcommand{\cseeauthorbio}[3][]{%
  \par\vspace{6pt}%
  \Needspace{3.1cm}%  照片(2.8cm)+文字物理高度,避免照片和作者条目跨栏拆散
  \begingroup
  \xiaowu\songti\cseetnr\setlength{\parindent}{0.63cm}%
  % 各行先绕开照片；正式接口再分别为标签和信息首行加入 2 字符缩进。
  \parshape 7 2.30cm \dimexpr\linewidth-2.30cm\relax
              2.30cm \dimexpr\linewidth-2.30cm\relax
              2.30cm \dimexpr\linewidth-2.30cm\relax
              2.30cm \dimexpr\linewidth-2.30cm\relax
              2.30cm \dimexpr\linewidth-2.30cm\relax
              2.30cm \dimexpr\linewidth-2.30cm\relax
              0pt \linewidth
  \noindent\llap{\smash{\raisebox{\dimexpr\baselineskip-\height\relax}{\includegraphics[width=2.2cm,height=2.8cm]{#2}}}\hspace{0.10cm}}#3\par
  % 六行绕排不足时补足照片高度，再把姓名置于照片正下方。
  \ifstrempty{#1}{}{\vspace{34pt}\noindent\makebox[2.2cm][c]{#1}\par}%
  \endgroup}
% 简洁写作接口：可选参数排在照片下方；照片右侧第一行是标签，第二行是作者信息。
\newcommand{\cseebiography}[3][]{%
  \cseebiographydivider
  \cseeauthorbio[#1]{#2}{\hspace*{0.63cm}\cseebiographylabel\newline\hspace*{0.63cm}#3}}

% 责任编辑与 Word 教程末尾“总则”块。
\newcommand{\cseeeditor}[1]{%
  \par\vspace{6pt}\Needspace{3\baselineskip}%
  {\fontsize{10.54pt}{16.15pt}\selectfont
   \hfill{\heiti(责任编辑\quad}{\kaishu #1}{\heiti)}\par}%
}
% 金样中的编辑格式说明：五号楷体；仅“编辑”及右引号为黑体；
% OOXML 标记段前 6pt，换算为 TeX 排版时以 4.8pt 得到相同基线位置。
\newcommand{\cseeeditornote}[1]{%
  \par\vspace{4.8pt}\noindent
  {\xeCJKsetup{PunctStyle=plain}\fontsize{10.54pt}{16.15pt}\selectfont
   \kaishu\cseekailatin
   “{\heiti 编辑”}\hspace{10.18pt}#1\par}%
}
\newenvironment{cseegeneral}{%
  \par\vspace{12pt}\begingroup\wuhao\heiti\cseetnr
  \setlength{\parindent}{0pt}%
  \noindent\begin{minipage}{\linewidth}% 保持总则完整，末页平衡时整体进入右栏
}{%
  \par\end{minipage}\endgroup
}

