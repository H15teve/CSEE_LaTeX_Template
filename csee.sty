% ASCII 连字符。例：2006CB2003\cseefundbreak 03。
\newcommand{\cseefundbreak}{\discretionary{-}{}{}}
% 基金块复用双栏脚注插入机制：TeX 会从当前（首页左侧）栏的正文高度中
% 扣除基金块实际高度，并把正文续排到右栏，因此内容变化不会与正文重叠。
% 规则线仍沿用 Word 金样的宽度和线宽；普通脚注也会使用同一规则线。
\setlength{\skip\footins}{8pt plus 2pt minus 2pt}
\renewcommand{\footnoterule}{%
  \kern -3pt
  \hrule \@width 113.3pt \@height 0.75pt
  \kern 6pt
}
\newcommand{\cseefund}[2]{%
  \if@twocolumn
    \if@firstcolumn\else
      \PackageWarning{csee}{\string\cseefund\space should be called at the
        start of the first column; placement may move to a later column}%
    \fi
  \else
    \PackageWarning{csee}{\string\cseefund\space is designed for two-column mode}%
  \fi
  \begingroup
    \renewcommand{\thefootnote}{}%
    \renewcommand{\@makefntext}[1]{\noindent ##1}%
    \footnotetext{%
      \begin{minipage}[t]{\columnwidth}
        \raggedright\fontsize{7.528pt}{12.045pt}\selectfont
        % 项目名称与编号使用正常字距；编号只在调用端标记的断点换行。
        \noindent\hspace*{15.056pt}{\heiti 基金项目}\songti ：#1。\par
        \noindent\hspace*{15.056pt}\cseetnr #2\par
        % Word 基金文本框底部保留约 13pt 空白；以内容内边距表达，
        % 不依赖页面坐标，并保持默认短基金块的纵向锚点。
        \vspace*{13pt}%
      \end{minipage}%
    }%
  \endgroup
}

