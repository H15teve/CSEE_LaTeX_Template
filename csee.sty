%%------------------------------------------------------------------%%
%% 3. 页面设置 (按 OOXML 实测;统一 headheight/headsep/footskip)       %%
%%    A4,上2.70 下2.00 左2.00 右2.00 cm,栏间距0.78cm                  %%
%%------------------------------------------------------------------%%
\geometry{
  paper=a4paper,
  top=2.70cm, bottom=2.00cm, left=2.00cm, right=2.00cm,
  headheight=2.0cm, headsep=0.37cm, footskip=0.8cm,
  columnsep=0.78cm,
}
% Word 的“每页 42 行”是段落网格约束，并不改变上下 2.70/2.00cm 的物理版心。
% 因此保留 geometry 算得的正文高度；金样中的对象占位由文档局部按网格表达。
% headheight=2.0cm(56.7pt)+headsep=0.37cm(10.5pt)=67.2pt
% 普通页content从headheight底+headsep≈67.2+topskip(10)≈77.2(Word普通页77.5);
% 首页通栏在\twocolumn[...]内,vspace*控制起点84.8;
% headheight(56.7pt)>fancyhdr单行head要求,无warning
% headsep=0.37cm 控制普通页页眉至正文距离；footskip=0.8cm 给页脚保留几何空间。

%%------------------------------------------------------------------%%
%% 4. 字号快捷命令 (固定基线,符合 Word 文档网格)                      %%
%%    正文 10.5/16.15pt;摘要/关键词/图表题/参考文献/附录 9/14pt;      %%
%%    表内 7.5/14pt                                                   %%
%%------------------------------------------------------------------%%
\renewcommand{\normalsize}{\@setfontsize\normalsize{\csee@wuhao}{16.15pt}}
\AtBeginDocument{%
  \normalfont\songti\cseetnr\fontsize{\csee@wuhao}{16.15pt}\selectfont
  \baselineskip=16.15pt\relax%   显式强制,防 ctex 覆盖为20.995
  \linespread{1}%
  \setlength{\parindent}{0.74cm}%
  \setlength{\parskip}{0pt}%
  \setlength{\emergencystretch}{3em}% 紧急拉伸消除中英混排轻微Overfull(非\sloppy)
}
\newcommand{\chuhao}{\fontsize{\csee@chuhao}{1.2\csee@chuhao}\selectfont}
\newcommand{\xiaochuhao}{\fontsize{\csee@xiaochuhao}{1.2\csee@xiaochuhao}\selectfont}
\newcommand{\yihao}{\fontsize{\csee@yihao}{1.2\csee@yihao}\selectfont}
\newcommand{\xiaoyihao}{\fontsize{\csee@xiaoyihao}{1.2\csee@xiaoyihao}\selectfont}
\newcommand{\erhao}{\fontsize{\csee@erhao}{36pt}\selectfont}% 22pt字行距36pt(Word实测标题行距)
\newcommand{\xiaoerhao}{\fontsize{\csee@xiaoerhao}{1.2\csee@xiaoerhao}\selectfont}
\newcommand{\sanhao}{\fontsize{\csee@sanhao}{1.2\csee@sanhao}\selectfont}
\newcommand{\xiaosanhao}{\fontsize{\csee@xiaosanhao}{1.2\csee@xiaosanhao}\selectfont}
\newcommand{\sihao}{\fontsize{\csee@sihao}{1.2\csee@sihao}\selectfont}
\newcommand{\xiaosi}{\fontsize{\csee@xiaosi}{16.15pt}\selectfont}
\newcommand{\wuhao}{\fontsize{\csee@wuhao}{16.15pt}\selectfont}
\newcommand{\xiaowu}{\fontsize{\csee@xiaowu}{14pt}\selectfont}
\newcommand{\liuhao}{\fontsize{\csee@liuhao}{14pt}\selectfont}
\newcommand{\xiaoliu}{\fontsize{\csee@xiaoliu}{14pt}\selectfont}
\newcommand{\qihao}{\fontsize{\csee@qihao}{14pt}\selectfont}

%%------------------------------------------------------------------%%
%% 5. 标题格式 (用 \ctexset)                                          %%
%%    1级:小四黑体/Arial,段前后6pt;2级:五号黑体/Arial,段前后0;        %%
%%    3级:五号宋体/TNR,段前后0                                        %%
%%    注意:黑体不叠加 \bfseries(SimHei 已是粗笔画,不伪粗)              %%
%%------------------------------------------------------------------%%
\ctexset{
  section = {
    format     = \sffamily\heiti\xiaosi,
    name       = {},
    number     = \arabic{section},
    aftername  = \quad,
    beforeskip = 6pt,
    afterskip  = 6pt,
    indent     = 0pt,
    hang       = false,
  },
  subsection = {
    format     = \sffamily\heiti\wuhao,
    name       = {},
    number     = \arabic{section}.\arabic{subsection},
    aftername  = \quad,
    beforeskip = 0pt,
    afterskip  = 0pt,
    indent     = 0pt,
    hang       = false,
  },
  subsubsection = {
    format     = \songti\wuhao,
    name       = {},
    number     = \arabic{section}.\arabic{subsection}.\arabic{subsubsection},
    aftername  = \quad,
    beforeskip = 0pt,
    afterskip  = 0pt,
    indent     = 0pt,
    hang       = false,
  },
}

%%------------------------------------------------------------------%%
%% 6. 页眉页脚 (首页 eso-pic 前景层 + fancy 普通页)                    %%
%%    首页:中文刊名+英文刊名+页码+双线,用 eso-pic shipout 绝对绘制,    %%
%%    双线在文章编号上方(不占用 fancyhdr 页眉槽,消除 headheight 警告)   %%
%%    普通页:仅页码,0.75pt单线(样式a3);偶数页:页码+中文刊名            %%
%%    首页刊名修正原 Word 模板偏移，按 A4 纸张宽度精确居中              %%
%%------------------------------------------------------------------%%
\gdef\csee@jnlcn{中国电机工程学报}
\gdef\csee@jnlen{Proceedings of the CSEE}
% \cseeheader{中文刊名}{英文刊名} — 保存供首页使用,设置普通页 fancy 样式
\newcommand{\cseeheader}[2]{%
  \gdef\csee@jnlcn{#1}\gdef\csee@jnlen{#2}%
  \pagestyle{fancy}\fancyhf{}%
  \fancyhead[LE]{\xiaowu\songti\cseetnr\thepage}        % 偶数页:左页码(样式a3单线)
  \fancyhead[CE]{\xiaowu\songti\ziju{1}\csee@jnlcn}    % 偶数页:中文刊名逐字疏排
  \fancyhead[RO]{\xiaowu\cseetnr\thepage}               % 普通奇数页:右页码(样式a3单线)
  \renewcommand{\headrulewidth}{0.75pt}%                 % 普通页单线 0.75pt (样式a3 sz=6)
  \renewcommand{\footrulewidth}{0pt}%
  \fancyfoot{}%
}
% 首页独立样式:head保留空占位(使\twocolumn通栏起点正常),页眉内容由eso-pic绘制
\fancypagestyle{csee-first}{%
  \fancyhf{}%
  \fancyhead[RO]{\hbox{}}%  空head占位,避免通栏起点上移;页码由eso-pic绘制
  \fancyfoot{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}
% shipout 前景层绘制首页页眉:双线在文章编号上方,不占页眉槽
% 刊名使用整张纸宽度的居中盒；页码和双线仍保持既有页面锚点。
% shipout 前景层绘制首页页眉(eso-pic,绝对页面坐标;y从底向上=841.89-顶坐标)
\RequirePackage{eso-pic}
\AddToShipoutPictureFG{%
  \ifnum\value{page}=1
  \put(0,779.0){\makebox[\paperwidth][c]{\fontsize{9pt}{9.3pt}\selectfont\ziju{1}\xiaowu\songti\csee@jnlcn}}%
  % Word 中英文两行可见字形间距比旧实现大约 2.9pt；页码与英文行同基线。
  \put(0,768.29){\makebox[\paperwidth][c]{\fontsize{9pt}{9.3pt}\selectfont\xiaowu\cseetnr\csee@jnlen}}%
  % picture 参考点补偿 2.015pt，使可见字形右缘与普通奇数页的
  % x=538.58pt 页边锚点重合。
  \put(540.595,768.29){\makebox[0pt][r]{\fontsize{9pt}{9.3pt}\selectfont\xiaowu\cseetnr\thepage}}%
  \put(56.7,764.4){\rule{481.88pt}{0.5pt}}%
  \put(56.7,763.4){\rule{481.88pt}{0.5pt}}%
  \fi
}

%%------------------------------------------------------------------%%
%% 7. 图表题注 (用 \DeclareCaptionFont 注册 9/14pt)                    %%
%%    中英文对照:中文行"表 1 …",英文行"Tab. 1 …"                      %%
%%    两行用 \\ 自然换行,不加额外 2pt                                 %%
%%------------------------------------------------------------------%%
\DeclareCaptionFont{cseenine}{\xiaowu}   % 9pt/14pt,已由 \xiaowu 定义
\captionsetup{
  font=cseenine,
  labelformat=empty,
  labelsep=none,
  justification=centering,
  singlelinecheck=false,
  skip=3pt,
}
\captionsetup[table]{position=above,aboveskip=3pt,belowskip=3pt}
\captionsetup[figure]{position=below,aboveskip=3pt,belowskip=3pt}
% 表题宏
\newcommand{\cseetablecaption}[2]{%
  \caption{\heiti 表\thetable\quad #1\\\cseetnr\bfseries Tab.\thetable\quad #2}%
}
% 图题宏
\newcommand{\cseefigurecaption}[2]{%
  \caption{\heiti 图~\thefigure\quad #1\\\cseetnr\bfseries Fig.~\thefigure\quad #2}%
}
% 非浮动双语图题接口(用于 minipage 内,直接居中段落不用parbox避免双倍宽度)
\newcommand{\cseefigurecaptionof}[2]{%
  \par\vspace{3pt}\refstepcounter{figure}%
  {\centering\heiti 图~\thefigure\quad #1\par\vspace{2pt}\cseetnr\bfseries Fig.~\thefigure\quad #2\par}%
}
% 非浮动金样图块：局部化 \centering，避免对后续正文造成状态泄漏。
\newenvironment{cseefigureblock}{%
